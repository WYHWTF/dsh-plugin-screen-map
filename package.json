{
  "name": "dsh-plugin-screen-map",
  "version": "0.1.1",
  "description": "把 screen_read 的冗长 UI 树压成紧凑「屏幕地图」，保留 element id 与坐标。纯 host 端，手机/电脑通用。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README-zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "screen",
    "tokens"
  ],
  "license": "MIT",
  "author": "WYHWTF",
  "repository": {
    "type": "git",
    "url": "https://github.com/WYHWTF/dsh-plugin-screen-map.git"
  },
  "homepage": "https://github.com/WYHWTF/dsh-plugin-screen-map#readme"
}
